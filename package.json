{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-isolated.mjs",
    "test:browser": "node scripts/build-browser-fixture.mjs && playwright test",
    "test:postgres": "node --import tsx scripts/postgres-readiness.mjs",
    "test:postgres:runtime": "node --import tsx scripts/postgres-runtime-readiness.mjs",
    "check:secrets": "node scripts/check-source-secrets.mjs",
    "db:migrate": "tsx server/scripts/runMigrations.ts",
    "db:verify": "tsx server/scripts/verifyDatabase.ts",
    "db:seed": "tsx server/scripts/seedRestaurantOperations.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.5",
    "datatables.net-bs5": "^3.1.4",
    "datatables.net-react": "^2.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serverless-http": "^4.0.0",
    "supertest": "^7.3.1",
    "vite": "^6.2.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
